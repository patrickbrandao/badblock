# Usado só quando esta pasta sobe sozinha. Pelo compose da raiz, valem os
# valores do .env da raiz.

POSTGRES_PASSWORD=
# Vazia se o Valkey rodar sem senha.
VALKEY_PASSWORD=
# Ou as URLs inteiras, para serviços fora da rede badblock (outro host):
# POSTGRES_URL=postgres://postgres:SENHA@host:5432/badblock?sslmode=require
# COLLECTOR_REGISTROBR_RDAPNUM_REDIS_URL=redis://:SENHA@host:6379/0

COLLECTOR_REGISTROBR_RDAPNUM_TAG=latest
COLLECTOR_REGISTROBR_RDAPNUM_REPLICAS=1
# Proxy de saída que roda o IP; leva senha, nunca no git.
# Ex.: http://usuario:senha@proxy:3128 ou socks5://usuario:senha@proxy:1080
COLLECTOR_REGISTROBR_RDAPNUM_PROXY_URL=
# Consultas por MINUTO por coletor; sem proxy, acima de 8 vêm truncadas.
COLLECTOR_REGISTROBR_RDAPNUM_RATE_LIMIT=32
COLLECTOR_REGISTROBR_RDAPNUM_SCAN_INTERVAL=168h
LOG_LEVEL=info
