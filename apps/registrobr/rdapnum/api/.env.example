# Usado só quando esta pasta sobe sozinha. Pelo compose da raiz, valem os
# valores do .env da raiz.

POSTGRES_PASSWORD=
# Vazia se o Valkey rodar sem senha.
VALKEY_PASSWORD=
# Ou as URLs inteiras, para serviços fora da rede badblock:
# POSTGRES_URL=postgres://postgres:SENHA@host:5432/badblock?sslmode=require
# API_REGISTROBR_RDAPNUM_REDIS_URL=redis://:SENHA@host:6379/0

API_REGISTROBR_RDAPNUM_TAG=latest
API_REGISTROBR_RDAPNUM_HOST_PORT=8114
API_REGISTROBR_RDAPNUM_CACHE_TTL=300
# Opcionais: cache desligado (a atualização continua) e o pool do Postgres.
# API_REGISTROBR_RDAPNUM_CACHE_ENABLED=true
# API_REGISTROBR_RDAPNUM_DB_POOL_MAX=10

# Publicação pelo Traefik do servidor.
API_FQDN=api.badblock.net.br
TRAEFIK_NETWORK=network_public
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
API_RATE_AVERAGE=5
API_RATE_BURST=20
# Rate limit próprio do POST .../refresh, por IP e por minuto (padrões 6,
# rajada 3).
# API_REGISTROBR_RDAPNUM_REFRESH_RATE_AVERAGE=6
# API_REGISTROBR_RDAPNUM_REFRESH_RATE_BURST=3
LOG_LEVEL=info
