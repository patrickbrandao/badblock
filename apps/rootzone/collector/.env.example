# Usado só quando esta pasta sobe sozinha. Pelo compose da raiz, valem os
# valores do .env da raiz.

POSTGRES_PASSWORD=
# Ou a URL inteira, para um Postgres fora da rede badblock:
# POSTGRES_URL=postgres://postgres:SENHA@host:5432/badblock?sslmode=require

COLLECTOR_ROOTZONE_TAG=latest
COLLECTOR_ROOTZONE_SYNC_INTERVAL=1h
COLLECTOR_ROOTZONE_RETRY_INTERVAL=5m
# Vazio = SOURCE_URL + ".md5"; "off" desliga a conferência do hash publicado.
COLLECTOR_ROOTZONE_SOURCE_MD5_URL=
COLLECTOR_ROOTZONE_MIN_TLDS=1000
COLLECTOR_ROOTZONE_REMOVAL_THRESHOLD=0.05
LOG_LEVEL=info
