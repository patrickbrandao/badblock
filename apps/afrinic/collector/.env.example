# Usado só quando esta pasta sobe sozinha. Pelo compose da raiz, valem os
# valores do .env da raiz.

POSTGRES_PASSWORD=
# Ou a URL inteira, para um Postgres fora da rede badblock:
# POSTGRES_URL=postgres://postgres:SENHA@host:5432/badblock?sslmode=require

COLLECTOR_AFRINIC_TAG=latest
COLLECTOR_AFRINIC_SYNC_INTERVAL=1h
COLLECTOR_AFRINIC_RETRY_INTERVAL=5m
# Vazios = padrão do app (arquivo delegated-extended do RIR, SOURCE_URL + ".md5"
# e o mínimo de registros medido no arquivo real).
COLLECTOR_AFRINIC_SOURCE_URL=
COLLECTOR_AFRINIC_SOURCE_MD5_URL=
COLLECTOR_AFRINIC_MIN_RECORDS=
COLLECTOR_AFRINIC_REMOVAL_THRESHOLD=0.05
LOG_LEVEL=info
