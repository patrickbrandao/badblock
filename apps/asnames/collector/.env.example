# Usado só quando esta pasta sobe sozinha. Pelo compose da raiz, valem os
# valores do .env da raiz.

POSTGRES_PASSWORD=
# Ou a URL inteira, para um Postgres fora da rede badblock:
# POSTGRES_URL=postgres://postgres:SENHA@host:5432/badblock?sslmode=require

COLLECTOR_ASNAMES_TAG=latest
COLLECTOR_ASNAMES_SYNC_INTERVAL=1h
COLLECTOR_ASNAMES_RETRY_INTERVAL=5m
COLLECTOR_ASNAMES_MIN_ASNS=100000
COLLECTOR_ASNAMES_REMOVAL_THRESHOLD=0.05
LOG_LEVEL=info
