# Usado só quando esta pasta sobe sozinha. Pelo compose da raiz, valem os
# valores do .env da raiz.

POSTGRES_PASSWORD=
# Vazia se o Valkey rodar sem senha.
VALKEY_PASSWORD=
# Ou as URLs inteiras, para serviços fora da rede badblock:
# POSTGRES_URL=postgres://postgres:SENHA@host:5432/badblock?sslmode=require
# API_ASNAMES_REDIS_URL=redis://:SENHA@host:6379/0

API_ASNAMES_TAG=latest
API_ASNAMES_HOST_PORT=8108
API_ASNAMES_CACHE_TTL=3600

# Publicação pelo Traefik do servidor.
API_FQDN=api.badblock.net.br
TRAEFIK_NETWORK=network_public
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
API_RATE_AVERAGE=5
API_RATE_BURST=20
LOG_LEVEL=info
