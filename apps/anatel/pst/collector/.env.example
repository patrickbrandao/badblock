# Usado só quando esta pasta sobe sozinha. Pelo compose da raiz, valem os
# valores do .env da raiz.

POSTGRES_PASSWORD=
# Ou a URL inteira, para um Postgres fora da rede badblock:
# POSTGRES_URL=postgres://postgres:SENHA@host:5432/badblock?sslmode=require

COLLECTOR_ANATEL_PST_TAG=latest
COLLECTOR_ANATEL_PST_SYNC_INTERVAL=24h
COLLECTOR_ANATEL_PST_RETRY_INTERVAL=5m
COLLECTOR_ANATEL_PST_MIN_PROVIDERS=30000
COLLECTOR_ANATEL_PST_REMOVAL_THRESHOLD=0.05
LOG_LEVEL=info
