# Usado só quando esta pasta sobe sozinha. Pelo compose da raiz, valem os
# valores do .env da raiz.

POSTGRES_PASSWORD=
# Vazia se o Valkey rodar sem senha.
VALKEY_PASSWORD=
# Ou as URLs inteiras, para serviços fora da rede badblock:
# POSTGRES_URL=postgres://postgres:SENHA@host:5432/badblock?sslmode=require
# API_RDNS_REDIS_URL=redis://:SENHA@host:6379/0

API_RDNS_TAG=latest
API_RDNS_HOST_PORT=8113
API_RDNS_CACHE_TTL=3600
# Opcionais: cache desligado (o tempo real continua) e o pool do Postgres.
# API_RDNS_CACHE_ENABLED=true
# API_RDNS_DB_POOL_MAX=10

# Publicação pelo Traefik do servidor.
API_FQDN=api.badblock.net.br
TRAEFIK_NETWORK=network_public
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
API_RATE_AVERAGE=5
API_RATE_BURST=20
# Rate limit próprio do live=true, por IP (padrões 1 req/s, rajada 5).
# API_RDNS_LIVE_RATE_AVERAGE=1
# API_RDNS_LIVE_RATE_BURST=5
LOG_LEVEL=info
