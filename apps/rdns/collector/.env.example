# Usado só quando esta pasta sobe sozinha. Pelo compose da raiz, valem os
# valores do .env da raiz.

POSTGRES_PASSWORD=
# Vazia se o Valkey rodar sem senha.
VALKEY_PASSWORD=
# Ou as URLs inteiras, para serviços fora da rede badblock (outro host):
# POSTGRES_URL=postgres://postgres:SENHA@host:5432/badblock?sslmode=require
# COLLECTOR_RDNS_REDIS_URL=redis://:SENHA@host:6379/0

COLLECTOR_RDNS_TAG=latest
COLLECTOR_RDNS_REPLICAS=1
# Resolvedores recursivos deste host; obrigatória.
COLLECTOR_RDNS_DNS_SERVERS=
COLLECTOR_RDNS_RATE_LIMIT=256
COLLECTOR_RDNS_SCAN_INTERVAL=24h
LOG_LEVEL=info
