# Usado só quando esta pasta sobe sozinha. Pelo compose da raiz, valem os
# valores do .env da raiz.

BADBLOCK_SYNC_PASSWORD=
# Ou a URL inteira, para um Postgres fora da rede badblock:
# REGISTRY_SYNC_POSTGRES_URL=postgres://badblock_sync:SENHA@host:5432/badblock?sslmode=require

DOCKERHUB_NAMESPACE=tmsoftbrasil
REGISTRY_SYNC_TAG=latest

SYNC_INTERVAL=1h
# Intervalos por fonte, ex.: iana-ipv4=6h,asnames=2h
SYNC_SOURCE_INTERVALS=
# Subconjunto de fontes (vazio = todas). Ids: registry-sync --help
SYNC_SOURCES=
# Lê as fontes de um diretório montado em vez da rede (e2e).
SOURCES_DIR=
REMOVAL_THRESHOLD=0.05
REMOVAL_GRACE=26h
RAW_KEEP=7
LOG_LEVEL=info
