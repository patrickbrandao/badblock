# ----------------------------------------------------------------------------
# BadBlock — variáveis do stack completo (docker-compose.yml da raiz).
#
# Copie para .env ou rode `make env`, que copia este arquivo e preenche
# POSTGRES_PASSWORD com um valor aleatório. O .env nunca vai para o git.
# ----------------------------------------------------------------------------

# --- PostgreSQL: acesso -----------------------------------------------------
# Banco dedicado: todos os serviços (migrations, collectors, APIs) usam o
# usuário postgres no banco badblock. Senha só com letras e números (entra na
# URL sem codificação). Sem POSTGRES_URL, ela é montada com esta senha:
#   postgres://postgres:$POSTGRES_PASSWORD@badblock-postgres:5432/badblock?sslmode=disable
POSTGRES_PASSWORD=
# POSTGRES_URL=

# Opcional: vazia, o Valkey sobe sem senha (só a rede badblock o alcança).
VALKEY_PASSWORD=

# --- Imagens (Docker Hub) ---------------------------------------------------
DOCKERHUB_NAMESPACE=tmsoftbrasil
# Tag de cada imagem (tmsoftbrasil/badblock-<app>); latest ou uma versão.
COLLECTOR_AFRINIC_TAG=latest
COLLECTOR_ANATEL_PST_TAG=latest
COLLECTOR_APNIC_TAG=latest
COLLECTOR_ARIN_TAG=latest
COLLECTOR_ASNAMES_TAG=latest
COLLECTOR_CGIBR_TAG=latest
COLLECTOR_IANA_TAG=latest
COLLECTOR_LACNIC_TAG=latest
COLLECTOR_RIPENCC_TAG=latest
COLLECTOR_ROOTANCHORS_TAG=latest
COLLECTOR_ROOTHINTS_TAG=latest
COLLECTOR_ROOTZONE_TAG=latest
API_AFRINIC_TAG=latest
API_ANATEL_PST_TAG=latest
API_APNIC_TAG=latest
API_ARIN_TAG=latest
API_ASNAMES_TAG=latest
API_CGIBR_TAG=latest
API_IANA_TAG=latest
API_LACNIC_TAG=latest
API_RIPENCC_TAG=latest
WEBSITE_WWW_TAG=latest
API_ROOTANCHORS_TAG=latest
API_ROOTHINTS_TAG=latest
API_ROOTZONE_TAG=latest

# --- PostgreSQL: servidor ---------------------------------------------------
# Porta no loopback do host (a 5432 do Mac de desenvolvimento já está em uso).
POSTGRES_HOST_PORT=5433
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_MAX_CONNECTIONS=200

# --- Valkey -----------------------------------------------------------------
VALKEY_MAXMEMORY=256mb

# --- Collectors -------------------------------------------------------------
# Cada collector verifica a fonte a cada SYNC_INTERVAL e, depois de uma
# falha (fonte fora do ar, banco subindo), tenta de novo em RETRY_INTERVAL.
# Variáveis vazias usam o padrão do próprio app (veja specs/fontes/<fonte>/collector.md e api.md).

# collector-cgibr: NIC.br / registro.br
COLLECTOR_CGIBR_SYNC_INTERVAL=1h
COLLECTOR_CGIBR_RETRY_INTERVAL=5m
COLLECTOR_CGIBR_MIN_ASNS=5000
COLLECTOR_CGIBR_REMOVAL_THRESHOLD=0.05

# collector-afrinic: delegações da AFRINIC (delegated-extended). MIN_RECORDS vazio = 10000.
COLLECTOR_AFRINIC_SYNC_INTERVAL=1h
COLLECTOR_AFRINIC_RETRY_INTERVAL=5m
COLLECTOR_AFRINIC_SOURCE_URL=
COLLECTOR_AFRINIC_SOURCE_MD5_URL=
COLLECTOR_AFRINIC_MIN_RECORDS=
COLLECTOR_AFRINIC_REMOVAL_THRESHOLD=0.05

# collector-apnic: delegações da APNIC (delegated-extended). MIN_RECORDS vazio = 95000.
COLLECTOR_APNIC_SYNC_INTERVAL=1h
COLLECTOR_APNIC_RETRY_INTERVAL=5m
COLLECTOR_APNIC_SOURCE_URL=
COLLECTOR_APNIC_SOURCE_MD5_URL=
COLLECTOR_APNIC_MIN_RECORDS=
COLLECTOR_APNIC_REMOVAL_THRESHOLD=0.05

# collector-arin: delegações da ARIN (delegated-extended). MIN_RECORDS vazio = 100000.
COLLECTOR_ARIN_SYNC_INTERVAL=1h
COLLECTOR_ARIN_RETRY_INTERVAL=5m
COLLECTOR_ARIN_SOURCE_URL=
COLLECTOR_ARIN_SOURCE_MD5_URL=
COLLECTOR_ARIN_MIN_RECORDS=
COLLECTOR_ARIN_REMOVAL_THRESHOLD=0.05

# collector-lacnic: delegações da LACNIC (delegated-extended). MIN_RECORDS vazio = 50000.
COLLECTOR_LACNIC_SYNC_INTERVAL=1h
COLLECTOR_LACNIC_RETRY_INTERVAL=5m
COLLECTOR_LACNIC_SOURCE_URL=
COLLECTOR_LACNIC_SOURCE_MD5_URL=
COLLECTOR_LACNIC_MIN_RECORDS=
COLLECTOR_LACNIC_REMOVAL_THRESHOLD=0.05

# collector-ripencc: delegações do RIPE NCC (delegated-extended). MIN_RECORDS vazio = 130000.
COLLECTOR_RIPENCC_SYNC_INTERVAL=1h
COLLECTOR_RIPENCC_RETRY_INTERVAL=5m
COLLECTOR_RIPENCC_SOURCE_URL=
COLLECTOR_RIPENCC_SOURCE_MD5_URL=
COLLECTOR_RIPENCC_MIN_RECORDS=
COLLECTOR_RIPENCC_REMOVAL_THRESHOLD=0.05

# collector-iana: 10 arquivos de registro da IANA (mudam poucas vezes por ano)
COLLECTOR_IANA_SYNC_INTERVAL=6h
COLLECTOR_IANA_RETRY_INTERVAL=5m
COLLECTOR_IANA_RUN_TIMEOUT=10m
COLLECTOR_IANA_IANA_BASE_URL=https://www.iana.org/assignments
COLLECTOR_IANA_RDAP_BASE_URL=https://data.iana.org/rdap
COLLECTOR_IANA_REMOVAL_THRESHOLD=0.05

# collector-asnames: nomes de AS do RIPE NCC (asn.txt)
COLLECTOR_ASNAMES_SYNC_INTERVAL=1h
COLLECTOR_ASNAMES_RETRY_INTERVAL=5m
COLLECTOR_ASNAMES_MIN_ASNS=100000
COLLECTOR_ASNAMES_REMOVAL_THRESHOLD=0.05

# collector-roothints: servidores raiz do DNS da InterNIC (named.root)
COLLECTOR_ROOTHINTS_SYNC_INTERVAL=1h
COLLECTOR_ROOTHINTS_RETRY_INTERVAL=5m
COLLECTOR_ROOTHINTS_MIN_SERVERS=13
COLLECTOR_ROOTHINTS_REMOVAL_THRESHOLD=0.05

# collector-rootzone: zona raiz do DNS da InterNIC (root.zone); SOURCE_MD5_URL vazia = SOURCE_URL + .md5
COLLECTOR_ROOTZONE_SYNC_INTERVAL=1h
COLLECTOR_ROOTZONE_RETRY_INTERVAL=5m
COLLECTOR_ROOTZONE_SOURCE_MD5_URL=
COLLECTOR_ROOTZONE_MIN_TLDS=1000
COLLECTOR_ROOTZONE_REMOVAL_THRESHOLD=0.05

# collector-rootanchors: âncoras de confiança DNSSEC da raiz (IANA root-anchors.xml)
COLLECTOR_ROOTANCHORS_SYNC_INTERVAL=6h
COLLECTOR_ROOTANCHORS_RETRY_INTERVAL=5m
COLLECTOR_ROOTANCHORS_MIN_KEYS=1
COLLECTOR_ROOTANCHORS_REMOVAL_THRESHOLD=0.05

# collector-anatel-pst: prestadoras de serviços de telecomunicações da Anatel
# (só CNPJ). Verifica a cada 24 h e aplica só se o arquivo mudou.
COLLECTOR_ANATEL_PST_SYNC_INTERVAL=24h
COLLECTOR_ANATEL_PST_RETRY_INTERVAL=5m
COLLECTOR_ANATEL_PST_MIN_PROVIDERS=30000
COLLECTOR_ANATEL_PST_REMOVAL_THRESHOLD=0.05

# --- APIs -------------------------------------------------------------------
# Porta de cada API no loopback do host, para testar sem Traefik:
#   curl http://127.0.0.1:8101/cgibr/asn/61613
# CACHE_TTL: segundos de cada resposta no Valkey.
API_CGIBR_HOST_PORT=8101
API_AFRINIC_HOST_PORT=8102
API_APNIC_HOST_PORT=8103
API_ARIN_HOST_PORT=8104
API_LACNIC_HOST_PORT=8105
API_RIPENCC_HOST_PORT=8106
API_IANA_HOST_PORT=8107
API_ASNAMES_HOST_PORT=8108
API_ROOTHINTS_HOST_PORT=8109
API_ROOTZONE_HOST_PORT=8110
API_ROOTANCHORS_HOST_PORT=8111
API_ANATEL_PST_HOST_PORT=8112

API_CGIBR_CACHE_TTL=3600
API_AFRINIC_CACHE_TTL=3600
API_APNIC_CACHE_TTL=3600
API_ARIN_CACHE_TTL=3600
API_LACNIC_CACHE_TTL=3600
API_RIPENCC_CACHE_TTL=3600
API_IANA_CACHE_TTL=3600
API_ASNAMES_CACHE_TTL=3600
API_ROOTHINTS_CACHE_TTL=3600
API_ROOTZONE_CACHE_TTL=3600
API_ROOTANCHORS_CACHE_TTL=3600
API_ANATEL_PST_CACHE_TTL=3600

# --- Sites ------------------------------------------------------------------
# Porta de cada site no loopback do host, para testar sem Traefik:
#   curl http://127.0.0.1:8201/
WEBSITE_WWW_HOST_PORT=8201

# --- Publicação das APIs e dos sites pelo Traefik ---------------------------------------
# Valores do servidor de produção. No desenvolvimento local o Traefik não é
# necessário (use a porta do loopback); a rede TRAEFIK_NETWORK só precisa
# existir (make network cria).
API_FQDN=api.badblock.net.br
# Domínio dos sites: o www responde por WEBSITE_DOMAIN e www.WEBSITE_DOMAIN;
# os outros, por <site>.WEBSITE_DOMAIN.
WEBSITE_DOMAIN=badblock.net.br
TRAEFIK_NETWORK=network_public
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
API_RATE_AVERAGE=5
API_RATE_BURST=20

LOG_LEVEL=info
