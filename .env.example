# ----------------------------------------------------------------------------
# BadBlock — variáveis do stack completo (docker-compose.yml da raiz).
#
# Copie para .env ou rode `make env`, que copia este arquivo e preenche as
# senhas com valores aleatórios. O .env nunca vai para o git.
# ----------------------------------------------------------------------------

# "dev" liga o Traefik local (infra/traefik). Em produção, deixe vazio: os apps
# usam o Traefik que já roda no servidor.
COMPOSE_PROFILES=dev

# --- Senhas -----------------------------------------------------------------
# Apenas letras e números: elas entram nas URLs de conexão (POSTGRES_URL e
# REDIS_URL) sem codificação.
POSTGRES_PASSWORD=
BADBLOCK_OWNER_PASSWORD=
BADBLOCK_SYNC_PASSWORD=
BADBLOCK_API_PASSWORD=
VALKEY_PASSWORD=

# --- Imagens (Docker Hub) ---------------------------------------------------
DOCKERHUB_NAMESPACE=tmsoftbrasil
REGISTRY_SYNC_TAG=latest
REGISTRY_API_TAG=latest

# --- Publicação da API pelo Traefik ----------------------------------------
API_FQDN=api.badblock.localhost
TRAEFIK_ENTRYPOINT=websecure
# Produção: "le" (Let's Encrypt do Traefik do servidor). Dev: vazio (mkcert).
TRAEFIK_CERTRESOLVER=
# Rate limit por IP do cliente (requisições/s e rajada), geral e para as
# listas por país/RIR.
API_RATE_AVERAGE=5
API_RATE_BURST=20
API_LISTS_RATE_AVERAGE=1
API_LISTS_RATE_BURST=5

# --- PostgreSQL -------------------------------------------------------------
# Porta no loopback do host (a 5432 do Mac de desenvolvimento já está em uso).
POSTGRES_HOST_PORT=5433
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_MAX_CONNECTIONS=200
BACKUP_TIME=03:30
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4

# --- Valkey -----------------------------------------------------------------
VALKEY_MAXMEMORY=256mb

# --- registry-sync ----------------------------------------------------------
SYNC_INTERVAL=1h
SYNC_SOURCE_INTERVALS=
REMOVAL_THRESHOLD=0.05
REMOVAL_GRACE=26h
# Lê as fontes de um diretório em vez da rede (usado pelo e2e). Vazio = rede.
SOURCES_DIR=

# --- registry-api -----------------------------------------------------------
REDIS_KEY_TTL=3600
LOG_LEVEL=info
