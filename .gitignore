# Versões anteriores e material de referência local — nunca vão para o git e
# não são lidos por agentes sem pedido explícito do usuário.
old/
tmp/

# Só os .env.example são versionados. Qualquer outro .env* (na raiz ou nas
# pastas de cada componente) guarda segredos e fica de fora.
.env
.env.*
!.env.example
# .mcp.json leva o token do servidor de skills.
.mcp.json

# Scripts de operação do mantenedor na raiz (run-*.sh, sync.sh...): guardam
# valores do ambiente dele e ficam fora do git.
/build.sh
/destroy.sh
/hub.sh
/sync.sh
/run-*.sh
/Update_and_fixes

# Artefatos de build e teste dos apps Go.
bin/
dist/
coverage.out
*.test

# Dependências, build e logs locais dos sites (websites/<site>/): nada que a
# compilação ou o servidor local produzem vai para o git.
/websites/*/node_modules/
/websites/*/dist/
/websites/*/.next/
/websites/*/.vite/
/websites/*/.src-work/
/websites/*/*.tsbuildinfo
/websites/*/*.log

# Sistema operacional e editores.
.DS_Store
.idea/
.vscode/
*.swp
