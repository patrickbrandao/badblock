# Usado só quando esta pasta sobe sozinha. Pelo compose da raiz, valem os
# valores do .env da raiz.

WEBSITE_WWW_TAG=latest
WEBSITE_WWW_HOST_PORT=8201

# Publicação pelo Traefik do servidor: responde por WEBSITE_DOMAIN e
# www.WEBSITE_DOMAIN.
WEBSITE_DOMAIN=badblock.net.br
TRAEFIK_NETWORK=network_public
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
