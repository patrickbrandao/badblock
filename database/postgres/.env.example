# Usado só quando esta pasta sobe sozinha. Pelo compose da raiz, valem os
# valores do .env da raiz. Senha: apenas letras e números (entra na URL).

POSTGRES_PASSWORD=
# Opcional: URL inteira (padrão: postgres://postgres:$POSTGRES_PASSWORD@badblock-postgres:5432/badblock)
# POSTGRES_URL=

POSTGRES_HOST_PORT=5433
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_MAX_CONNECTIONS=200
