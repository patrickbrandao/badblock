# Usado só quando esta pasta sobe sozinha (docker compose up nesta pasta).
# Pelo compose da raiz, valem os valores do .env da raiz.
#
# Senhas: use apenas letras e números — elas entram nas URLs de conexão.

POSTGRES_PASSWORD=
BADBLOCK_OWNER_PASSWORD=
BADBLOCK_SYNC_PASSWORD=
BADBLOCK_API_PASSWORD=

# Porta no loopback do host (a 5432 do Mac de desenvolvimento já está em uso).
POSTGRES_HOST_PORT=5433
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_MAX_CONNECTIONS=200

# Backup diário (horário em UTC) e retenção.
BACKUP_TIME=03:30
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
