-- Bootstrap do BadBlock. Roda como superusuário, via 00-bootstrap.sh, e é
-- idempotente: cada execução cria o que falta e reaplica senhas e permissões.
--
-- A extensão .psql é proposital: o entrypoint da imagem oficial executa
-- sozinho os arquivos .sql de docker-entrypoint-initdb.d, e este arquivo
-- depende das variáveis que o 00-bootstrap.sh passa ao psql.
--
-- Roles:
--   badblock_owner  dono do banco e de todos os objetos; roda as migrations
--   badblock_sync   registry-sync; escreve nos schemas ingest e registry
--   badblock_api    registry-api; só lê as views do schema api

\set ON_ERROR_STOP on

-- Roles ---------------------------------------------------------------------

SELECT format('CREATE ROLE %I LOGIN', r)
  FROM unnest(ARRAY['badblock_owner', 'badblock_sync', 'badblock_api']) AS r
 WHERE NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = r)
\gexec

ALTER ROLE badblock_owner LOGIN PASSWORD :'owner_password';
ALTER ROLE badblock_sync  LOGIN PASSWORD :'sync_password' CONNECTION LIMIT 20;
ALTER ROLE badblock_api   LOGIN PASSWORD :'api_password'  CONNECTION LIMIT 200;

-- Banco ---------------------------------------------------------------------

SELECT format('CREATE DATABASE %I OWNER badblock_owner ENCODING %L TEMPLATE template0',
              :'database', 'UTF8')
 WHERE NOT EXISTS (SELECT 1 FROM pg_database WHERE datname = :'database')
\gexec

-- Só os roles do BadBlock conectam. O TEMPORARY do sync é para as tabelas de
-- staging, que vivem só durante a transação de cada carga.
SELECT format('REVOKE ALL ON DATABASE %I FROM PUBLIC', :'database') \gexec
SELECT format('GRANT CONNECT, TEMPORARY ON DATABASE %I TO badblock_sync', :'database') \gexec
SELECT format('GRANT CONNECT ON DATABASE %I TO badblock_api', :'database') \gexec

-- Extensões (exigem superusuário) ------------------------------------------

\connect :"database"

-- Estatísticas de consultas, para investigar lentidão em produção. Só coleta
-- se o servidor subir com shared_preload_libraries=pg_stat_statements, como
-- faz o docker-compose.yml desta pasta.
CREATE EXTENSION IF NOT EXISTS pg_stat_statements;
